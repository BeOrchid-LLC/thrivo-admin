# API base (server + client). Admin calls /api/v1/admin/* on the backend.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk Admin app publishable key (BeOrchid Admin Clerk application).
# Value is CLERK_ADMIN_PUBLISHABLE_KEY from thrivo-backend.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Frontend API host used by the CSP; match the publishable key instance.
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# Render tables/charts from local fixtures instead of live data.
# Default OFF. Set to 1 to enable (e.g. during UI development without a backend).
# NEXT_PUBLIC_USE_FIXTURES=0
