# API base (server + client). Admin calls /api/v1/admin/* on the backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Render tables/charts from local fixtures until the backend admin endpoints
# exist. Default ON; set to 0 to use live data.
NEXT_PUBLIC_USE_FIXTURES=1

# Skip the admin session/role check while the backend auth is unwired so the UI
# is reviewable. Default ON outside production; set to 0 to enforce. TODO: remove.
ADMIN_DEV_BYPASS=1
