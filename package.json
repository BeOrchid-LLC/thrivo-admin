{
  "name": "thrivo-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib middleware.ts",
    "format:check": "prettier --check app components lib middleware.ts",
    "checks": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
